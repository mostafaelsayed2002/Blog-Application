# Copy this to `.env` ON THE SERVER, next to docker-compose.prod.yml.
# The real .env is never committed — it holds the database password.
#
#   cp .env.prod.example .env && nano .env

# Public domain, used for the backend's CORS origin.
DOMAIN=elsayed2002.tech

# Docker Hub account the CI pipeline pushes images to.
DOCKERHUB_USERNAME=elsayed2002

# Which image tag to run. "latest" tracks main; pin to a git SHA to roll back,
# e.g. IMAGE_TAG=a4b6265... then `docker compose -f docker-compose.prod.yml up -d`
IMAGE_TAG=latest

# Postgres. Generate a strong password, e.g.  openssl rand -base64 32
POSTGRES_USER=blog
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=blog
